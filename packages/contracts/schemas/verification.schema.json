{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification Result",
  "type": "object",
  "required": ["verification_id", "decision", "confidence", "document", "biometric", "risk"],
  "properties": {
    "verification_id": { "type": "string" },
    "decision": { "type": "string", "enum": ["VERIFIED", "REVIEW", "REJECTED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "document": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "number_masked": { "type": "string" },
        "authenticity_score": { "type": "number" },
        "ocr_confidence": { "type": "number" },
        "mrz_status": { "type": "string" },
        "tamper_status": { "type": "string" }
      }
    },
    "biometric": {
      "type": "object",
      "properties": {
        "face_similarity": { "type": "number" },
        "liveness": { "type": "string" },
        "quality": { "type": "number" }
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}